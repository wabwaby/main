# ---- Supabase ----
# Project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=

# SERVICE ROLE key. Server-side only — NEVER ship this to the browser.
# Found in: Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Server ----
PORT=3001

# Comma-separated list of origins allowed to call this proxy.
# Example: http://localhost:5173,https://your-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173

# ---- Bandai scraper ----
# Base used when the client sends a bare cardId (e.g. ?cardId=ST01-001).
# The English Gundam Card Game site is the sensible default.
BANDAI_CARD_BASE_URL=https://www.gundam-gcg.com/en/cards/index.php
