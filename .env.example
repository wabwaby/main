# Copy this file to .env and fill in your values.
# .env is gitignored.

# --- Option A: hosted OpenAI ---
DIARY_API_KEY=sk-...
DIARY_MODEL=gpt-4o-mini

# --- Option B: any OpenAI-compatible endpoint (OpenRouter, Groq, etc.) ---
# DIARY_API_KEY=...
# DIARY_BASE_URL=https://openrouter.ai/api/v1
# DIARY_MODEL=anthropic/claude-3.5-sonnet

# --- Option C: local Ollama (no key needed) ---
# DIARY_BASE_URL=http://localhost:11434/v1
# DIARY_MODEL=llama3.1

# Optional: where to store diary files (default: ./entries)
# DIARY_DIR=~/Documents/diary

# Optional: default personality (cheerleader / coach / friend / roast)
# DIARY_MOOD=coach
